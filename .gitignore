runs/
output_dir/
output_folder/
logs/
curves/
checkpoints/
feature_cache/
feature_caches/
*.pth
*.pt
*.ckpt
*.safetensors

# Python caches and local virtual environments.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Local credentials and machine-specific settings; keep example templates.
.env
.env.*
!.env.example
!.env.template
.aws/
.ssh/
.netrc
credentials/
secrets/
*.pem
*.key
